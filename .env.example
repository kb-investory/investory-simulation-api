# ==============================================================================
# Investory Unified AI Backend Server Environment Variables (.env.example)
# ==============================================================================
# 사용 법: 본 파일(.env.example)을 복사하여 프로젝트 루트 경로에 '.env' 파일로 생성한 후
#         실제 API Key 및 원하시는 설정값을 입력해 주세요.
#         (미입력 시 룰 기반 Fallback 엔진으로 자동 안전 작동합니다)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI LLM API Keys & Provider Configurations
# ------------------------------------------------------------------------------
# A. OpenAI API Key (https://platform.openai.com/ 에서 발급)
OPENAI_API_KEY=your_openai_api_key_here

# B. Google Gemini AI API Key (https://aistudio.google.com/ 에서 무료 발급)
GEMINI_API_KEY=your_gemini_api_key_here

# C. AI 모델 2티어 구성
#    작업 성격에 따라 두 등급으로 나눠 사용합니다. 아래 두 값만 바꾸면 전체가 따라갑니다.
#
#    REASONING_MODEL : 틀리면 비용이 큰 다단계 판단용.
#                      (자연어 원칙 ➔ 실행 규칙 매핑, 웹 검색 기반 근거 검증)
#                      추론에 출력 토큰을 크게 쓰고 느리므로 비동기 작업에만 사용합니다.
#    FAST_MODEL      : 결정론적 엔진이 사실을 이미 확정한 뒤의 대량 분류·문장 생성용.
#                      (공시 호재/악재 분류, 리포트 설명문)
REASONING_MODEL=gpt-5-nano
FAST_MODEL=gpt-4o-mini

# D. 모듈별 개별 지정 (비워두면 위 티어 기본값을 따릅니다)
#COMPILER_MODEL=              # 자연어 원칙 ➔ 8대 영역 Rule JSON 파싱 (기본: REASONING_MODEL)
#EVIDENCE_SEARCH_MODEL=       # 근거 자료 웹 검색·수집 (기본: FAST_MODEL)
#EVIDENCE_JUDGMENT_MODEL=     # 수집된 자료로 근거 실현 여부 판정 (기본: REASONING_MODEL)
#THESIS_VERIFICATION_MODEL=   # 위 두 값을 한 번에 지정하는 하위 호환 설정
#DISCLOSURE_MODEL=            # OpenDART 공시 호재/악재 분석 (기본: FAST_MODEL)
#REPORT_MODEL=                # 시뮬레이션 복기 리포트 설명문 생성 (기본: FAST_MODEL)

# E. 호출 제한 및 타임아웃
LLM_TIMEOUT=30                 # 일반(FAST) 작업 응답 대기 한도(초)
REASONING_LLM_TIMEOUT=120      # 추론 작업 응답 대기 한도(초). 웹 검색은 도구 호출이 여러 번 발생합니다.
REASONING_MAX_OUTPUT_TOKENS=20000 # 추론 작업 출력 토큰 상한. 부족하면 추론만 하고 답을 못 내고 잘립니다.

# F. OpenDART 공시 수집 1회당 최대 LLM 호출 제한 (서킷 브레이커)
#    주의: 현재 이 설정은 공시 수집기에만 적용되며 리포트/웹검증 경로에는 적용되지 않습니다.
MAX_LLM_CALLS_PER_RUN=50

# ------------------------------------------------------------------------------
# 2. Financial & Data Provider Configurations
# ------------------------------------------------------------------------------
# 금융감독원 OpenDART API Key (https://opendart.fss.or.kr/ 에서 발급)
# - 실제 전자공시 수집 파이프라인 연동 시 사용됩니다.
OPENDART_API_KEY=your_opendart_api_key_here

# 한국거래소 KRX Data Marketplace Open API 인증키
KRX_OPEN_API_KEY=your_krx_open_api_key_here

# ------------------------------------------------------------------------------
# 3. Database Connection Configurations
# ------------------------------------------------------------------------------
# PostgreSQL / MySQL 데이터베이스 접속 URL (3단계 시세 및 공시 DB 적재용)
DATABASE_URL=postgresql://user:password@localhost:5432/investory

# ------------------------------------------------------------------------------
# 4. Server & Network Configurations
# ------------------------------------------------------------------------------
# 통합 백엔드 FastAPI 서버 구동 포트 (기본값: 8000)
PORT=8000

# CORS 허용 프론트엔드 도메인 (쉼표로 구분)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 5. Authentication (kbinvestory-backend JWT 검증)
# ------------------------------------------------------------------------------
# kbinvestory-backend가 RS256으로 서명해 발급하는 액세스 토큰을 검증할 JWKS 엔드포인트.
# 이 서비스는 토큰을 발급하지 않습니다 — 검증 전용입니다.
# 값이 비어있으면 앱은 정상 기동하되, 인증이 필요한 요청은 전부 401로 거부됩니다.
AUTH_JWKS_URL=https://your-backend-host/api/.well-known/jwks.json
