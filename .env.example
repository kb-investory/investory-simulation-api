# ==============================================================================
# Investory Unified AI Backend Server Environment Variables (.env.example)
# ==============================================================================
# 사용 법: 본 파일(.env.example)을 복사하여 프로젝트 루트 경로에 '.env' 파일로 생성한 후
#         실제 API Key 및 원하시는 설정값을 입력해 주세요.
#         (미입력 시 룰 기반 Fallback 엔진으로 자동 안전 작동합니다)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI LLM API Keys & Provider Configurations
# ------------------------------------------------------------------------------
# A. OpenAI API Key (https://platform.openai.com/ 에서 발급)
OPENAI_API_KEY=your_openai_api_key_here

# B. Google Gemini AI API Key (https://aistudio.google.com/ 에서 무료 발급)
GEMINI_API_KEY=your_gemini_api_key_here

# C. 모듈별 AI LLM 모델 개별 지정 (원하시는 모델명을 자유롭게 변경 가능)
COMPILER_MODEL=gpt-5-nano       # 자연어 원칙 ➔ 8대 영역 Rule JSON 파싱 모듈 모델 (기본값: gpt-5-nano)
DISCLOSURE_MODEL=gpt-4o-mini     # OpenDART 공시 ➔ 호재/악재 심층 분석 모듈 모델 (기본값: gpt-4o-mini)
REPORT_MODEL=gpt-4o-mini         # 시뮬레이션 백테스트 AI 성과 복기 리포트 생성기 모델 (기본값: gpt-4o-mini)
THESIS_VERIFICATION_MODEL=gpt-5.4-nano # 핵심 3개 거래의 투자 근거 사후 실현 여부 웹 검색 검증 모델

# D. 1회 백테스트/시뮬레이션 연산당 최대 LLM API 호출 허용 제한 (서킷 브레이커 안전장치)
MAX_LLM_CALLS_PER_RUN=50

# ------------------------------------------------------------------------------
# 2. Financial & Data Provider Configurations
# ------------------------------------------------------------------------------
# 금융감독원 OpenDART API Key (https://opendart.fss.or.kr/ 에서 발급)
# - 실제 전자공시 수집 파이프라인 연동 시 사용됩니다.
OPENDART_API_KEY=your_opendart_api_key_here

# 한국거래소 KRX Data Marketplace Open API 인증키
KRX_OPEN_API_KEY=your_krx_open_api_key_here

# ------------------------------------------------------------------------------
# 3. Database Connection Configurations
# ------------------------------------------------------------------------------
# PostgreSQL / MySQL 데이터베이스 접속 URL (3단계 시세 및 공시 DB 적재용)
DATABASE_URL=postgresql://user:password@localhost:5432/investory

# ------------------------------------------------------------------------------
# 4. Server & Network Configurations
# ------------------------------------------------------------------------------
# 통합 백엔드 FastAPI 서버 구동 포트 (기본값: 8000)
PORT=8000

# CORS 허용 프론트엔드 도메인 (쉼표로 구분)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
